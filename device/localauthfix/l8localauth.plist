<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ElleKit/Substrate filter. Foundation is in every Objective-C process,
	  so this reaches apps and daemons alike (Settings, the marketplace's
	  AppDistributionLaunchAngel, lockdownd). l8localauth links
	  LocalAuthentication itself, so LAContext exists when its constructor runs
	  even in a process that had not loaded the framework yet.
	-->
	<key>Filter</key>
	<dict>
		<key>Bundles</key>
		<array>
			<string>com.apple.Foundation</string>
		</array>
	</dict>
</dict>
</plist>
